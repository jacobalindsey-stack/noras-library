// Cloudflare settings for noralindsey.com.
// The whole site is static files in this folder; there is no build step.
// worker/index.js (the NUBBINS online relay) is not switched on yet: the first
// try to deploy it was refused by Cloudflare (Nov 23 2026). To switch it on,
// add back:
//   "main": "worker/index.js",
//   "assets": { ..., "binding": "ASSETS" },
//   "durable_objects": { "bindings": [{ "name": "NUBBINS_ROOMS", "class_name": "NubbinsRoom" }] },
//   "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NubbinsRoom"] }]
{
  "name": "noras-library",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
